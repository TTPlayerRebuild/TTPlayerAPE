      VALUE "OriginalFilename", "ttp_ape.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild APE\0"
      VALUE "ProductVersion", "@APE_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
